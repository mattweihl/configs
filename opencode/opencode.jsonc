{
  "$schema": "https://opencode.ai/config.json",
  "formatter": {
    "air": { "disabled": true },
    "biome": { "disabled": true },
    "cargofmt": { "disabled": true },
    "clang-format": { "disabled": true },
    "cljfmt": { "disabled": true },
    "dart": { "disabled": true },
    "dfmt": { "disabled": true },
    "gleam": { "disabled": true },
    "gofmt": { "disabled": true },
    "htmlbeautifier": { "disabled": true },
    "ktlint": { "disabled": true },
    "mix": { "disabled": true },
    "nixfmt": { "disabled": true },
    "ocamlformat": { "disabled": true },
    "ormolu": { "disabled": true },
    "oxfmt": { "disabled": true },
    "pint": { "disabled": true },
    "prettier": { "disabled": true },
    "rubocop": { "disabled": true },
    "ruff": { "disabled": true },
    "shfmt": { "disabled": true },
    "standardrb": { "disabled": true },
    "terraform": { "disabled": true },
    "uv": { "disabled": true },
    "zig": { "disabled": true },
    "agent-edits": {
      "command": [
        "sh",
        "{env:HOME}/configs/agents/hooks/format-edits.sh",
        "$FILE"
      ],
      "extensions": [
        ".ts",
        ".tsx",
        ".js",
        ".jsx",
        ".mjs",
        ".cjs",
        ".css",
        ".scss",
        ".html",
        ".json",
        ".jsonc",
        ".md",
        ".yml",
        ".yaml",
        ".py",
        ".sql",
        ".tf",
        ".tfvars"
      ]
    }
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    }
  }
}
